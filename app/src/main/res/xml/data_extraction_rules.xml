<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Scans never leave the device through a backup or a device transfer:
     page images, originals, OCR text, covers, the library database and the pointer to the
     current scan are excluded; the settings are kept. Android 11 and older read backup_rules.xml,
     which lists the same paths (guarded by BackupRulesTest). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="scans"/>
        <exclude domain="file" path="scans_covers"/>
        <exclude domain="file" path="documents"/>
        <exclude domain="file" path="registry"/>
        <exclude domain="file" path="Pictures"/>
        <exclude domain="database" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="sharedpref" path="session_ids.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="scans"/>
        <exclude domain="file" path="scans_covers"/>
        <exclude domain="file" path="documents"/>
        <exclude domain="file" path="registry"/>
        <exclude domain="file" path="Pictures"/>
        <exclude domain="database" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="sharedpref" path="session_ids.xml"/>
    </device-transfer>
</data-extraction-rules>
