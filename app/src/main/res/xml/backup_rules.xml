<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (Auto Backup). The same exclusions as data_extraction_rules.xml: scans
     stay on the device, the settings are backed up. -->
<full-backup-content>
    <exclude domain="file" path="scans"/>
    <exclude domain="file" path="scans_covers"/>
    <exclude domain="file" path="documents"/>
    <exclude domain="file" path="registry"/>
    <exclude domain="file" path="Pictures"/>
    <exclude domain="database" path="."/>
    <exclude domain="external" path="."/>
    <exclude domain="sharedpref" path="session_ids.xml"/>
    <exclude domain="sharedpref" path="export_locations.xml"/>
</full-backup-content>
