<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/options_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <!-- Scan: what happens between capture and export -->
        <TextView
            android:id="@+id/section_scan"
            style="@style/Widget.MakeACopy.OptionsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/options_section_scan" />

        <LinearLayout
            android:id="@+id/group_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/dialog_checkbox_skip_ocr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skip_ocr_export_only" />

            <CheckBox
                android:id="@+id/dialog_checkbox_skip_cropping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skip_cropping" />

            <CheckBox
                android:id="@+id/dialog_checkbox_skip_edge_detection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skip_edge_detection" />

            <CheckBox
                android:id="@+id/dialog_checkbox_analysis_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_corner_detection" />
        </LinearLayout>

        <!-- Camera: how the picture is taken -->
        <TextView
            android:id="@+id/section_camera"
            style="@style/Widget.MakeACopy.OptionsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/options_section_camera" />

        <LinearLayout
            android:id="@+id/group_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/dialog_checkbox_exposure_compensation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exposure_compensation_option" />

            <CheckBox
                android:id="@+id/dialog_checkbox_manual_focus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/manual_focus_option" />

            <CheckBox
                android:id="@+id/dialog_checkbox_focus_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/focus_quality_option" />

            <CheckBox
                android:id="@+id/dialog_checkbox_low_light_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/low_light_prompt_option" />
        </LinearLayout>

        <!-- OCR: recognition mode and post-processing (shared with the OCR screen's dialog) -->
        <TextView
            android:id="@+id/section_ocr"
            style="@style/Widget.MakeACopy.OptionsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_ocr" />

        <LinearLayout
            android:id="@+id/group_ocr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/panel_ocr_options" />
        </LinearLayout>

        <!-- Export: output options (shared with the Export screen's dialog) -->
        <TextView
            android:id="@+id/section_export"
            style="@style/Widget.MakeACopy.OptionsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_export" />

        <LinearLayout
            android:id="@+id/group_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/panel_export_options" />
        </LinearLayout>

        <!-- Library: cleanup of completed scans (shared with the library's gear button) -->
        <TextView
            android:id="@+id/section_library"
            style="@style/Widget.MakeACopy.OptionsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/options_section_library" />

        <LinearLayout
            android:id="@+id/group_library"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/panel_library_options" />
        </LinearLayout>

        <!-- App: settings that apply everywhere -->
        <TextView
            android:id="@+id/section_app"
            style="@style/Widget.MakeACopy.OptionsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/options_section_app" />

        <LinearLayout
            android:id="@+id/group_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/dialog_checkbox_accessibility_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/accessibility_mode_label" />

            <!-- FLAG_SECURE on the main window: no screenshots, no recents preview of scans -->
            <CheckBox
                android:id="@+id/dialog_checkbox_protect_screen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protect_screen_content_option" />

            <!-- App lock: fingerprint, face or the screen lock after a start or 30 s away -->
            <CheckBox
                android:id="@+id/dialog_checkbox_app_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_lock_option" />

            <!-- In-app UI language: label plus current value, opens a picker -->
            <LinearLayout
                android:id="@+id/row_app_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_language_label"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <TextView
                    android:id="@+id/text_app_language_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:textColorSecondary" />
            </LinearLayout>

            <!-- Help and privacy policy: open a page in DocumentActivity -->
            <TextView
                android:id="@+id/row_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/menu_help"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/row_privacy_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/menu_privacy_policy"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <!-- Share logs: a row like Help and Privacy policy above it -->
            <TextView
                android:id="@+id/button_share_logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/share_logs"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
