<?xml version="1.0" encoding="utf-8"?>
<!-- The OCR options (PaddleOCR switches), without padding or scrolling, so that the OCR
     screen's dialog and the camera options dialog can both include them. OcrOptionsPanel binds
     this layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ocr_options_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <CheckBox
        android:id="@+id/checkbox_ocr_auto_rotate_apply_export_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/opt_ocr_auto_rotate_apply_export" />

    <CheckBox
        android:id="@+id/checkbox_paddle_best_ocr_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/opt_paddle_best_ocr" />

    <CheckBox
        android:id="@+id/checkbox_multi_column_ocr_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/opt_multi_column_ocr" />
</LinearLayout>
